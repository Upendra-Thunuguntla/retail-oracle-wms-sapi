		<ee:transform doc:name="Transform Message" doc:id="3a016332-65c3-4b9f-98a7-7db312f2fc20" >
			<ee:message >
				<ee:set-payload ><![CDATA[%dw 2.0
output application/java
---
{
}]]></ee:set-payload>
			</ee:message>
		</ee:transform>
		<sftp:read doc:name="Read" doc:id="ad09050e-2585-4397-85ee-16bc61816bfb" config-ref="azure-sftp-config"/>
	</flow>
</mule>
